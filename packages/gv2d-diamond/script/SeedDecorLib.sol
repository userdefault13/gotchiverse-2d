pragma solidity ^0.8.20;

import {GvCatalogFacet} from "../src/facets/GvCatalogFacet.sol";
import {LibAppStorage} from "../src/libraries/LibAppStorage.sol";

/// @notice Register all type-7 level-1 Decor on GV catalog.
/// @dev GV ERC1155 ids = L1 itemId + 1000 (avoids soft-tile band 8–47 collision).
///      Distinct from Base Installation diamond type-7 — do not mint on L1 here.
///      Costs from installations.json / decor-craft-costs.base-sepolia.json (1e18), paymentEnabled=false.
library SeedDecorLib {
    uint256 internal constant DECOR_ID_OFFSET = 1000;

    function _cost(uint256 fud, uint256 fomo, uint256 alpha, uint256 kek)
        internal
        pure
        returns (LibAppStorage.AlchemicaCost memory)
    {
        return LibAppStorage.AlchemicaCost({fud: fud, fomo: fomo, alpha: alpha, kek: kek});
    }

    function _reg(
        uint256 l1Id,
        uint8 width,
        uint8 height,
        LibAppStorage.AlchemicaCost memory cost
    ) internal pure returns (GvCatalogFacet.SoftInstallRegistration memory) {
        return GvCatalogFacet.SoftInstallRegistration({
            id: l1Id + DECOR_ID_OFFSET,
            installationType: 7,
            level: 1,
            width: width,
            height: height,
            nextLevelId: 0,
            cost: cost
        });
    }

