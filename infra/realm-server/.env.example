PORT=2567
HOST=0.0.0.0
NODE_ENV=production

CORS_ORIGINS=https://gotchiverse-2d.vercel.app,https://*.vercel.app,http://localhost:3001,http://127.0.0.1:3001

JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_SECONDS=86400

PUBLIC_URL=https://realm.aarcadeghst.com

CORE_SUBGRAPH_URL=https://aarcadeghst.com/api/subgraph/aavegotchi-core-base
GOTCHIVERSE_SUBGRAPH_URL=https://aarcadeghst.com/api/subgraph/gotchiverse-base

# true for first smoke; set false once ownership checks are verified
SKIP_OWNERSHIP_CHECK=true

# Aarcade SIM pocket credits (aarena-rh KO prizes)
AARCADE_CARTRIDGE_SIM_URL=https://aarcadeghst.com/api/cartridge-sim
AARCADE_POCKET_CREDIT_SECRET=
RH_KO_PRIZE_AMOUNT=1000000000000000
RH_KO_MAX_CREDITS_PER_DAY=20
RH_KO_PAIR_COOLDOWN_MS=30000

# Local/testing: hotkeys 7/8/9/0 credit SIM NVDA on aarena-rh
RH_TEST_DROP_ENABLED=false
RH_TEST_DROP_AMOUNT=1000000000000000

# Aarena join CTA (PLAY NOW vs COMING SOON)
COMBAT_IS_LIVE=true
