APP_ENV='local'
NODE_ENV=development
REALM_NETWORK='base'
ALCHEMICA_NETWORK='base'
NETWORK='base'
NEXT_PUBLIC_API_URL='http://localhost:2567'
NEXT_PUBLIC_COLYSEUS_URL='http://localhost:2567'
NEXT_PUBLIC_NETCODE='colyseus'
NEXT_PUBLIC_RECAPTCHA_SITE_KEY='your-recaptcha-site-key'
OAUTH_LINK='http://discord.com/api/oauth2/authorize?client_id=970997234072166491&redirect_uri=http%3A%2F%2Flocalhost%3A3001%2Fauth%2Fdiscord%2Fcallback&response_type=code&scope=identify%20email%20guilds%20guilds.join%20guilds.members.read'

# Aarcade Discord verification (server-only — used by /api/aarcade-verify)
AARCADE_VERIFY_URL='https://aarcadeghst.com/api/gotchiverse-verify'
AARCADE_VERIFY_SECRET=''
NEXT_PUBLIC_AARCADE_HOME='https://aarcadeghst.com'

# Aarcade cartridge soft launch (used by /api/aarcade-cartridge + mint)
# Stamps (SRC-721 SIM) run inside this service when Aarcade sets BTC_ORDINALS_SIM_ENABLED=true
AARCADE_CARTRIDGE_SIM_URL='https://aarcadeghst.com/api/cartridge-sim'
# Optional override; defaults to NEXT_PUBLIC_AARCADE_HOME/api/game-session
AARCADE_GAME_SESSION_URL=''
NEXT_PUBLIC_AARCADE_CARTRIDGE_GAME_ID='gotchiverse'

# Base subgraphs via Aarcade Envio proxy (Goldsky Base is sunsetting)
NEXT_PUBLIC_AARCADE_HOME='https://aarcadeghst.com'
NEXT_PUBLIC_CORE_SUBGRAPH_URL='https://aarcadeghst.com/api/subgraph/aavegotchi-core-base'
NEXT_PUBLIC_GOTCHIVERSE_SUBGRAPH_URL='https://aarcadeghst.com/api/subgraph/gotchiverse-base'
NEXT_PUBLIC_SVG_SUBGRAPH_URL='https://aarcadeghst.com/api/subgraph/aavegotchi-svg-base'
NEXT_PUBLIC_BASE_RPC='https://mainnet.base.org'

# Optional integrations. Leave blank for local UI-only development.
ALCHEMICA_API_URL=''
ALCHEMICA_DEPOSIT=''
ARCX_API_KEY=''
BLOCKNATIVE_API_KEY=''
GHOST_API_KEY=''
INFURA_ID=''
MORALIS_API_KEY=''
NEXT_PUBLIC_SENTRY_DSN=''
SENTRY_DSN=''
SERVER_URL=''
USE_LOCALHOST=''
VENLY_CLIENT_ID=''

# Hybrid Grid Foundry PoC (localStorage logistics; Colyseus when NETCODE=colyseus)
NEXT_PUBLIC_ENABLE_FOUNDRY_POC='true'
# PixelLab.ai art generation (Foundry PoC sprites; 500-image budget)
PIXELLAB_API_URL='https://api.pixellab.ai'
PIXELLAB_API_TOKEN='your-pixellab-api-token'

# Home Mongo (Aarcade tunnel) — Waall/Lodge PoC persistence via /api/offchain
# Without these, craft/place still work via localStorage mirror.
# MONGO_PROXY_URL='https://mongo-api.aarcadeghst.com'
# MONGO_PROXY_SECRET='same-as-aarcade-home-proxy'
# MONGO_DB_NAME='Aarcadeghst'
# MONGO_PROXY_TIMEOUT_MS='15000'
